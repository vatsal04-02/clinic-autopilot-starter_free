# LOCAL DEMO settings (docker-compose.demo.yml). Copy to .env.demo (git-ignored), then run ./scripts/gen-demo-secrets.sh .env.demo
# NEVER commit .env.demo. Nothing here is a real credential: the demo uses no WhatsApp number, no paid AI and no real patient data.

# --- versions: pin EXACT versions (the demo is reproducible only if they do not move) ---
N8N_VERSION=
GRIST_VERSION=
# OLLAMA_VERSION=

# --- secrets: ./scripts/gen-demo-secrets.sh fills the empty ones ---
N8N_ENCRYPTION_KEY=
GRIST_SESSION_SECRET=
FLOWHQ_SESSION_SECRET=

# --- Grist ---
# unsandboxed: demo data only. Leave as is on a laptop.
GRIST_SANDBOX_FLAVOR=unsandboxed
# After you create the two Grist documents (n8n/demo/DEMO.md, step 2):
DEMO_REGISTRY_DOC_ID=
DEMO_GRIST_API_KEY=

# --- the scripted patient console (n8n/demo/patient-console.js) - export these in your SHELL, they are not read by Docker ---
# Use the same values you paste into the workflow (W2 – Signature Config > meta_app_secret, MCC – Config > mcc_webhook_secret).
DEMO_N8N_URL=http://127.0.0.1:5678
DEMO_CALL_SECRET=
DEMO_META_APP_SECRET=
DEMO_WA_PHONE_NUMBER_ID=100000000000001
DEMO_CALLED_NUMBER=+919000000100
